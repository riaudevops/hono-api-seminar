generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PenilaiRole {
  KP_INSTANSI
  KP_PEMBIMBING
  KP_PENGUJI
  TA_PEMBIMBING_1
  TA_PEMBIMBING_2
  TA_PENGUJI_1
  TA_PENGUJI_2
  TA_KETUA_SIDANG
}

enum LogActionType {
  CREATE
  UPDATE
  DELETE
  GANTI_JADWAL
  GANTI_DOSEN
}

enum LogActorType {
  KOORDINATOR
  DOSEN
  MAHASISWA
}

enum LogEntityType {
  JADWAL
  PENILAIAN
}

enum StatusJadwalDraft {
  DRAFT
  APPROVED
  REJECTED
}

enum ConstraintType {
  AVAILABLE_TIME
  UNAVAILABLE_TIME
  PREFERENCE
  LOCATION
}

enum StatusBerkas {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
}

model dosen {
  nip    String @id @db.VarChar(18)
  nama   String @db.VarChar(255)
  email  String @unique @db.VarChar(255)
  no_hp  String? @unique @db.VarChar(14)

  penilaian penilaian[]
  constraintDosens constraint_dosen[]
  keahlian_dosen   keahlian_dosen[]
}

model bidang_keahlian {
  id   String @id @default(cuid())
  nama String @unique @db.VarChar(100)

  keahlian_dosen keahlian_dosen[]
}

model keahlian_dosen {
  id                 String @id @default(cuid())
  nip                String @db.VarChar(18)
  id_bidang_keahlian String

  dosen           dosen           @relation(fields: [nip], references: [nip], onDelete: Cascade)
  bidang_keahlian bidang_keahlian @relation(fields: [id_bidang_keahlian], references: [id], onDelete: Cascade)

  @@unique([nip, id_bidang_keahlian])
  @@index([nip])
  @@index([id_bidang_keahlian])
}

model mahasiswa {
  nim    String @id @db.VarChar(11)
  nama   String @db.VarChar(255)
  email  String @unique @db.VarChar(36)
  aktif  Boolean @default(true)
  no_hp  String? @unique @db.VarChar(14)

  jadwal jadwal[]
  pendaftaran pendaftaran[]
}

model ruangan {
  kode   String @id @db.VarChar(10)
  nama   String @db.VarChar(50)
  status Boolean @default(true) @db.Boolean

  jadwal jadwal[]
}

model jadwal {
  id            String   @id @db.VarChar(14)
  tanggal       DateTime @db.Timestamptz
  judul         String?  @db.VarChar(255)
  waktu_mulai   DateTime @db.Timestamptz
  waktu_selesai DateTime @db.Timestamptz

  id_jenis_seminar String
  jenis_seminar    jenis_seminar @relation(fields: [id_jenis_seminar], references: [id])

  nim String
  mahasiswa mahasiswa @relation(fields: [nim], references: [nim])

  kode_ruangan String
  ruangan ruangan @relation(fields: [kode_ruangan], references: [kode])

  kode_tahun_ajaran String @db.VarChar(5)

  penilaian penilaian[]

  @@index([tanggal])
  @@index([nim, kode_tahun_ajaran])
  @@index([kode_ruangan, tanggal])
  @@index([id_jenis_seminar])
}

model jadwal_draft {
  id             String            @id @default(cuid())
  batch_id       String            @db.VarChar(20)
  nim            String

  id_jenis_seminar String
  jenis_seminar    jenis_seminar @relation(fields: [id_jenis_seminar], references: [id])

  judul          String            @db.VarChar(255)

  tanggal        DateTime          @db.Timestamptz
  waktu_mulai    DateTime          @db.Timestamptz
  waktu_selesai  DateTime          @db.Timestamptz
  kode_ruangan   String            @db.VarChar(10)

  // Format JSON: [{nip: "...", role: "TA_PEMBIMBING_1"}, {nip: "...", role: "TA_PENGUJI_1"}]
  list_dosen   Json

  llm_reasoning  Json?
  confidence     Float?
  status         StatusJadwalDraft @default(DRAFT)

  created_at     DateTime          @default(now()) @db.Timestamptz

  @@index([batch_id])
  @@index([status])
  @@index([id_jenis_seminar])
}

model komponen_penilaian {
  id         String  @id @db.VarChar(7)
  nama       String  @db.VarChar(50)
  persentase Int
  is_aktif   Boolean @default(true)
  role       PenilaiRole

  detail_penilaian detail_penilaian[]
}

model penilaian {
  id        String @id @default(cuid())
  id_jadwal String
  nip       String
  role      PenilaiRole

  jadwal jadwal @relation(fields: [id_jadwal], references: [id], onDelete: Restrict)
  dosen  dosen  @relation(fields: [nip], references: [nip])

  detail_penilaian detail_penilaian[]

  @@unique([id_jadwal, nip])
  @@index([id_jadwal])
  @@index([nip])
}

model detail_penilaian {
  id              String @id @default(cuid())
  id_penilaian    String
  id_komponen     String
  nilai           Float

  penilaian penilaian @relation(fields: [id_penilaian], references: [id], onDelete: Cascade)
  komponen  komponen_penilaian @relation(fields: [id_komponen], references: [id])

  @@unique([id_penilaian, id_komponen])
  @@index([id_komponen])
}

// ============================================================
// Log polymorphic — menggantikan log_jadwal dan log_penilaian.
// entity_type + entity_id memetakan ke tabel target (JADWAL -> jadwal.id, PENILAIAN -> jadwal.id).
// context menyimpan metadata tambahan spesifik entity (misal id_komponen_penilaian untuk PENILAIAN).
// ============================================================
model log {
  id         String        @id @default(cuid())
  timestamp  DateTime      @default(now()) @db.Timestamptz
  action     LogActionType

  actor_type LogActorType
  actor_id   String

  entity_type LogEntityType
  entity_id   String

  context    Json?
  old_values Json?
  new_values Json?

  @@index([entity_type, entity_id])
  @@index([actor_type, actor_id])
  @@index([timestamp])
}

model constraint_dosen {
  id          String         @id @default(cuid())
  nip         String         @db.VarChar(18)
  type        ConstraintType

  hari        Int?
  waktu_mulai  DateTime?      @db.Timestamptz
  waktu_selesai DateTime?     @db.Timestamptz

  keterangan  String?        @db.Text

  priority    Int            @default(1)

  is_active   Boolean        @default(true)
  created_at  DateTime       @default(now()) @db.Timestamptz
  updated_at  DateTime       @updatedAt @db.Timestamptz

  dosen       dosen          @relation(fields: [nip], references: [nip])

  raw_data   Json?

  @@index([nip])
  @@index([type])
  @@index([nip, is_active])
}

// ============================================================
// KONFIGURASI JENIS SEMINAR (dikelola Admin/Koordinator)
// ============================================================

model jenis_seminar {
  id          String  @id @default(cuid())
  kode        String  @unique @db.VarChar(20)
  nama        String  @db.VarChar(100)
  deskripsi   String? @db.Text
  is_aktif    Boolean @default(true)

  jumlah_pembimbing Int @default(1)
  jumlah_penguji    Int @default(2)
  ada_ketua_sidang  Boolean @default(false)

  requirement_dokumen requirement_dokumen[]
  pendaftaran   pendaftaran[]
  jadwal        jadwal[]
  jadwal_draft  jadwal_draft[]

  @@index([kode])
}

enum TipeInputDokumen {
  FILE_UPLOAD
  TEXT
  URL
  BOOLEAN
  DATE
  SELECT
  MULTI_SELECT
}

model dokumen_template {
  id          String            @id @default(cuid())
  nama        String            @db.VarChar(150)
  kode        String            @unique @db.VarChar(50)
  deskripsi   String?           @db.Text
  tipe_input  TipeInputDokumen

  opsi        Json?

  format_file  String?          @db.VarChar(50)
  max_size_mb  Int?

  is_special   Boolean          @default(false)

  requirement_dokumen requirement_dokumen[]
  data_pendaftaran data_pendaftaran[]
}

model requirement_dokumen {
  id                  String   @id @default(cuid())
  id_jenis_seminar    String
  id_dokumen_template String

  urutan              Int      @default(0)
  is_wajib            Boolean  @default(true)
  keterangan_tambahan String?  @db.Text

  jenis_seminar    jenis_seminar    @relation(fields: [id_jenis_seminar], references: [id], onDelete: Cascade)
  dokumen_template dokumen_template @relation(fields: [id_dokumen_template], references: [id], onDelete: Cascade)

  @@unique([id_jenis_seminar, id_dokumen_template])
  @@index([id_jenis_seminar])
}

model pendaftaran {
  id                String       @id @default(cuid())
  nim               String       @db.VarChar(11)
  tahun_ajaran      String       @db.VarChar(5)
  id_pengajuan_fst  String       @unique @db.VarChar(50)

  id_jenis_seminar  String
  jenis_seminar     jenis_seminar @relation(fields: [id_jenis_seminar], references: [id])

  nim_mahasiswa     mahasiswa     @relation(fields: [nim], references: [nim])

  nip_pembimbing_1  String       @db.VarChar(18)
  nip_pembimbing_2  String?      @db.VarChar(18)
  nip_penguji_1     String?      @db.VarChar(18)
  nip_penguji_2     String?      @db.VarChar(18)
  nip_ketua_sidang  String?      @db.VarChar(18)

  status_berkas     StatusBerkas @default(PENDING)
  created_at        DateTime     @default(now()) @db.Timestamptz

  data_pendaftaran  data_pendaftaran[]

  @@index([nim])
  @@index([id_jenis_seminar])
  @@index([status_berkas])
  @@index([tahun_ajaran, id_jenis_seminar])
}

model data_pendaftaran {
  id                  String  @id @default(cuid())
  id_pendaftaran      String
  id_dokumen_template String

  nilai_text     String?  @db.Text
  nilai_file_url String?  @db.Text
  nilai_boolean  Boolean?
  nilai_date     DateTime? @db.Timestamptz
  nilai_json     Json?

  pendaftaran      pendaftaran      @relation(fields: [id_pendaftaran], references: [id], onDelete: Cascade)
  dokumen_template dokumen_template @relation(fields: [id_dokumen_template], references: [id])

  @@unique([id_pendaftaran, id_dokumen_template])
  @@index([id_pendaftaran])
}
