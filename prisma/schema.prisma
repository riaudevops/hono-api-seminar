generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum JenisJadwal {
  SEMKP
  SEMPRO
  SEMHAS_LAPORAN
  SEMHAS_PAPERBASED
  SIDANG_LAPORAN
  SIDANG_PAPERBASED
}

enum PenilaiRole {
  KP_INSTANSI
  KP_PEMBIMBING
  KP_PENGUJI
  TA_PEMBIMBING_1
  TA_PEMBIMBING_2
  TA_PENGUJI_1
  TA_PENGUJI_2
  TA_KETUA_SIDANG
}

enum LogActionType {
  CREATE
  UPDATE
  DELETE
  GANTI_JADWAL
  GANTI_DOSEN
}

enum LogActorType {
  KOORDINATOR
  DOSEN
  MAHASISWA
}

enum StatusJadwalDraft {
  DRAFT
  APPROVED
  REJECTED
}

enum ConstraintType {
  AVAILABLE_TIME    // Ketersediaan waktu (Misal: Hanya bisa Senin pagi)
  UNAVAILABLE_TIME  // Waktu berhalangan (Misal: Cuti atau Mengajar)
  PREFERENCE        // Preferensi (Misal: Ingin menguji maksimal 3 kali sehari)
  LOCATION          // Batasan fisik (Misal: Hanya bisa di Kampus A / Online)
}

enum StatusBerkas {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
}

model dosen {
  nip    String @id @db.VarChar(18)
  nama   String @db.VarChar(255)
  email  String @unique @db.VarChar(255)
  no_hp  String? @unique @db.VarChar(14)

  penilaian penilaian[]
  constraintDosens constraint_dosen[]
  keahlian_dosen   keahlian_dosen[]
}

// Tabel Master untuk menyimpan daftar bidang keahlian yang ada
model bidang_keahlian {
  id   String @id @default(cuid())
  nama String @unique @db.VarChar(100)

  keahlian_dosen keahlian_dosen[]
}

// Tabel Pivot (Relasi) yang menghubungkan Dosen dengan Bidang Keahliannya
model keahlian_dosen {
  id                 String @id @default(cuid())
  nip                String @db.VarChar(18)
  id_bidang_keahlian String

  dosen           dosen           @relation(fields: [nip], references: [nip], onDelete: Cascade)
  bidang_keahlian bidang_keahlian @relation(fields: [id_bidang_keahlian], references: [id], onDelete: Cascade)

  @@unique([nip, id_bidang_keahlian]) // Mencegah data ganda (1 dosen tidak bisa ditambahkan keahlian yang sama 2x)
  @@index([nip])
  @@index([id_bidang_keahlian])
}


model mahasiswa {
  nim    String @id @db.VarChar(11)
  nama   String @db.VarChar(255)
  email  String @unique @db.VarChar(36)
  aktif  Boolean @default(true)

  jadwal jadwal[]
}

model ruangan {
  kode   String @id @db.VarChar(10)
  nama   String @db.VarChar(50)
  status Boolean @default(true) @db.Boolean

  jadwal jadwal[]
}

model jadwal {
  id            String   @id @db.VarChar(14)
  tanggal       DateTime @db.Timestamptz
  judul         String?  @db.VarChar(255)
  waktu_mulai   DateTime @db.Timestamptz
  waktu_selesai DateTime @db.Timestamptz
  jenis         JenisJadwal

  nim String
  mahasiswa mahasiswa @relation(fields: [nim], references: [nim])

  kode_ruangan String
  ruangan ruangan @relation(fields: [kode_ruangan], references: [kode])

  kode_tahun_ajaran String @db.VarChar(5)

  penilaian penilaian[]

  @@index([tanggal])
}

model jadwal_draft {
  id             String            @id @default(cuid())
  batch_id       String            @db.VarChar(20) // Untuk mengelompokkan jadwal draft dalam satu batch proses AI
  nim            String
  jenis          JenisJadwal
  judul          String            @db.VarChar(255)

  // Slot yang diusulkan AI
  tanggal        DateTime          @db.Timestamptz
  waktu_mulai    DateTime          @db.Timestamptz
  waktu_selesai  DateTime          @db.Timestamptz
  kode_ruangan   String            @db.VarChar(10)

  // Data Penilai dari Spreadsheet (Disimpan sementara)
  // Format JSON: [{nip: "...", role: "TA_PEMBIMBING_1"}, {nip: "...", role: "TA_PENGUJI_1"}]
  list_dosen   Json              

  // Metadata AI
  llm_reasoning  Json?
  confidence     Float?
  status         StatusJadwalDraft @default(DRAFT)

  created_at     DateTime          @default(now()) @db.Timestamptz
}
model komponen_penilaian {
  id         String  @id @db.VarChar(7)
  nama       String  @db.VarChar(50)
  persentase Int
  is_aktif   Boolean @default(true)
  role       PenilaiRole

  detail_penilaian detail_penilaian[]
}

model penilaian {
  id        String @id @default(cuid())
  id_jadwal String
  nip       String
  role      PenilaiRole

  jadwal jadwal @relation(fields: [id_jadwal], references: [id])
  dosen  dosen  @relation(fields: [nip], references: [nip])

  detail_penilaian detail_penilaian[]

  @@unique([id_jadwal, nip])
  @@index([id_jadwal])
  @@index([nip])
}

model detail_penilaian {
  id              String @id @default(cuid())
  id_penilaian    String
  id_komponen     String
  nilai           Float

  penilaian penilaian @relation(fields: [id_penilaian], references: [id], onDelete: Cascade)
  komponen  komponen_penilaian @relation(fields: [id_komponen], references: [id])

  @@unique([id_penilaian, id_komponen])
  @@index([id_komponen])
}

model log_jadwal {
  id        String    @id @default(cuid())
  timestamp DateTime  @default(now()) @db.Timestamptz()
  action    LogActionType

  actor_type LogActorType
  actor_id   String

  jadwal_id String

  old_values Json?
  new_values Json?

  @@index([jadwal_id])
  @@index([actor_id])
}

model log_penilaian {
  id        String    @id @default(cuid())
  timestamp DateTime  @default(now()) @db.Timestamptz()
  action    LogActionType

  actor_type LogActorType
  actor_id   String

  id_jadwal             String
  id_komponen_penilaian String
  
  old_nilai Int?
  new_nilai Int?

  @@index([id_jadwal])
  @@index([actor_id])
}

model constraint_dosen {
  id          String         @id @default(cuid())
  nip         String         @db.VarChar(18)
  type        ConstraintType
  
  // Rentang waktu jika constraint berbasis waktu
  hari        Int?           // 1 (Senin) - 7 (Minggu)
  waktu_mulai  DateTime?      @db.Timestamptz
  waktu_selesai DateTime?     @db.Timestamptz
  
  // Deskripsi tekstual untuk diproses LLM (NLP)
  keterangan  String?        @db.Text
  
  // Metadata tambahan untuk LLM (misal: bobot prioritas 1-5)
  priority    Int            @default(1) 
  
  is_active   Boolean        @default(true)
  created_at  DateTime       @default(now()) @db.Timestamptz
  updated_at  DateTime       @updatedAt @db.Timestamptz

  dosen       dosen          @relation(fields: [nip], references: [nip])

  raw_data   Json?

  @@index([nip])
  @@index([type])
}

model pendaftaran {
  id                         String      @id @db.VarChar(35)
  nim                        String      @db.VarChar(11)
  nama                       String      @db.VarChar(255)
  semester                   Int
  id_pengajuan_fst           String      @unique @db.VarChar(50)
  no_wa                      String      @db.VarChar(15)
  jenis_seminar              JenisJadwal
  judul                      String?     @db.VarChar(255)

  nip_pembimbing_1           String      @db.VarChar(18)
  nip_pembimbing_2           String?     @db.VarChar(18)
  nip_penguji_1              String      @db.VarChar(18)
  nip_penguji_2              String      @db.VarChar(18)

  mata_kuliah_pilihan        Json?

  berkas_syarat_url          String      @db.Text
  undangan_sebelumnya_url    String?     @db.Text

  created_at                 DateTime    @default(now()) @db.Timestamptz
  status_berkas              StatusBerkas     @default(PENDING)
  status_proses              Boolean     @default(false)

  @@index([nim])
  @@index([id_pengajuan_fst])
}