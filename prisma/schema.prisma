generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum JenisJadwal {
  SEMKP
  SEMPRO
  SEMHAS_LAPORAN
  SEMHAS_PAPERBASED
  SIDANG_LAPORAN
  SIDANG_PAPERBASED
}

enum PenilaiRole {
  KP_INSTANSI
  KP_PEMBIMBING
  KP_PENGUJI
  TA_PEMBIMBING_1
  TA_PEMBIMBING_2
  TA_PENGUJI_1
  TA_PENGUJI_2
  TA_KETUA_SIDANG
}

enum LogActionType {
  CREATE
  UPDATE
  DELETE
  GANTI_JADWAL
  GANTI_DOSEN
}

enum LogActorType {
  KOORDINATOR
  DOSEN
  MAHASISWA
}

enum StatusJadwalDraft {
  DRAFT
  APPROVED
  REJECTED
}

enum ConstraintType {
  AVAILABLE_TIME    // Ketersediaan waktu (Misal: Hanya bisa Senin pagi)
  UNAVAILABLE_TIME  // Waktu berhalangan (Misal: Cuti atau Mengajar)
  PREFERENCE        // Preferensi (Misal: Ingin menguji maksimal 3 kali sehari)
  LOCATION          // Batasan fisik (Misal: Hanya bisa di Kampus A / Online)
}

enum StatusBerkas {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
}

model dosen {
  nip    String @id @db.VarChar(18)
  nama   String @db.VarChar(255)
  email  String @unique @db.VarChar(255)
  no_hp  String? @unique @db.VarChar(14)

  penilaian penilaian[]
  constraintDosens constraint_dosen[]
  keahlian_dosen   keahlian_dosen[]
}

// Tabel Master untuk menyimpan daftar bidang keahlian yang ada
model bidang_keahlian {
  id   String @id @default(cuid())
  nama String @unique @db.VarChar(100)

  keahlian_dosen keahlian_dosen[]
}

// Tabel Pivot (Relasi) yang menghubungkan Dosen dengan Bidang Keahliannya
model keahlian_dosen {
  id                 String @id @default(cuid())
  nip                String @db.VarChar(18)
  id_bidang_keahlian String

  dosen           dosen           @relation(fields: [nip], references: [nip], onDelete: Cascade)
  bidang_keahlian bidang_keahlian @relation(fields: [id_bidang_keahlian], references: [id], onDelete: Cascade)

  @@unique([nip, id_bidang_keahlian]) // Mencegah data ganda (1 dosen tidak bisa ditambahkan keahlian yang sama 2x)
  @@index([nip])
  @@index([id_bidang_keahlian])
}


model mahasiswa {
  nim    String @id @db.VarChar(11)
  nama   String @db.VarChar(255)
  email  String @unique @db.VarChar(36)
  aktif  Boolean @default(true)
  no_hp  String? @unique @db.VarChar(14)

  jadwal jadwal[]
  pendaftaran pendaftaran[]
}

model ruangan {
  kode   String @id @db.VarChar(10)
  nama   String @db.VarChar(50)
  status Boolean @default(true) @db.Boolean

  jadwal jadwal[]
}

model jadwal {
  id            String   @id @db.VarChar(14)
  tanggal       DateTime @db.Timestamptz
  judul         String?  @db.VarChar(255)
  waktu_mulai   DateTime @db.Timestamptz
  waktu_selesai DateTime @db.Timestamptz
  jenis         JenisJadwal

  nim String
  mahasiswa mahasiswa @relation(fields: [nim], references: [nim])

  kode_ruangan String
  ruangan ruangan @relation(fields: [kode_ruangan], references: [kode])

  kode_tahun_ajaran String @db.VarChar(5)

  penilaian penilaian[]

  @@index([tanggal])
}

model jadwal_draft {
  id             String            @id @default(cuid())
  batch_id       String            @db.VarChar(20) // Untuk mengelompokkan jadwal draft dalam satu batch proses AI
  nim            String
  jenis          JenisJadwal
  judul          String            @db.VarChar(255)

  // Slot yang diusulkan AI
  tanggal        DateTime          @db.Timestamptz
  waktu_mulai    DateTime          @db.Timestamptz
  waktu_selesai  DateTime          @db.Timestamptz
  kode_ruangan   String            @db.VarChar(10)

  // Data Penilai dari Spreadsheet (Disimpan sementara)
  // Format JSON: [{nip: "...", role: "TA_PEMBIMBING_1"}, {nip: "...", role: "TA_PENGUJI_1"}]
  list_dosen   Json              

  // Metadata AI
  llm_reasoning  Json?
  confidence     Float?
  status         StatusJadwalDraft @default(DRAFT)

  created_at     DateTime          @default(now()) @db.Timestamptz
}
model komponen_penilaian {
  id         String  @id @db.VarChar(7)
  nama       String  @db.VarChar(50)
  persentase Int
  is_aktif   Boolean @default(true)
  role       PenilaiRole

  detail_penilaian detail_penilaian[]
}

model penilaian {
  id        String @id @default(cuid())
  id_jadwal String
  nip       String
  role      PenilaiRole

  jadwal jadwal @relation(fields: [id_jadwal], references: [id])
  dosen  dosen  @relation(fields: [nip], references: [nip])

  detail_penilaian detail_penilaian[]

  @@unique([id_jadwal, nip])
  @@index([id_jadwal])
  @@index([nip])
}

model detail_penilaian {
  id              String @id @default(cuid())
  id_penilaian    String
  id_komponen     String
  nilai           Float

  penilaian penilaian @relation(fields: [id_penilaian], references: [id], onDelete: Cascade)
  komponen  komponen_penilaian @relation(fields: [id_komponen], references: [id])

  @@unique([id_penilaian, id_komponen])
  @@index([id_komponen])
}

model log_jadwal {
  id        String    @id @default(cuid())
  timestamp DateTime  @default(now()) @db.Timestamptz()
  action    LogActionType

  actor_type LogActorType
  actor_id   String

  jadwal_id String

  old_values Json?
  new_values Json?

  @@index([jadwal_id])
  @@index([actor_id])
}

model log_penilaian {
  id        String    @id @default(cuid())
  timestamp DateTime  @default(now()) @db.Timestamptz()
  action    LogActionType

  actor_type LogActorType
  actor_id   String

  id_jadwal             String
  id_komponen_penilaian String
  
  old_nilai Int?
  new_nilai Int?

  @@index([id_jadwal])
  @@index([actor_id])
}

model constraint_dosen {
  id          String         @id @default(cuid())
  nip         String         @db.VarChar(18)
  type        ConstraintType
  
  // Rentang waktu jika constraint berbasis waktu
  hari        Int?           // 1 (Senin) - 7 (Minggu)
  waktu_mulai  DateTime?      @db.Timestamptz
  waktu_selesai DateTime?     @db.Timestamptz
  
  // Deskripsi tekstual untuk diproses LLM (NLP)
  keterangan  String?        @db.Text
  
  // Metadata tambahan untuk LLM (misal: bobot prioritas 1-5)
  priority    Int            @default(1) 
  
  is_active   Boolean        @default(true)
  created_at  DateTime       @default(now()) @db.Timestamptz
  updated_at  DateTime       @updatedAt @db.Timestamptz

  dosen       dosen          @relation(fields: [nip], references: [nip])

  raw_data   Json?

  @@index([nip])
  @@index([type])
}

// ============================================================
// KONFIGURASI JENIS SEMINAR (dikelola Admin/Koordinator)
// ============================================================

model jenis_seminar {
  id          String  @id @default(cuid())
  kode        String  @unique @db.VarChar(20) // "SEMKP", "SEMPRO", dst
  nama        String  @db.VarChar(100)        // "Seminar Kerja Praktek"
  deskripsi   String? @db.Text
  is_aktif    Boolean @default(true)

  // Konfigurasi penilai: berapa pembimbing, penguji, dll
  jumlah_pembimbing Int @default(1)
  jumlah_penguji    Int @default(2)
  ada_ketua_sidang  Boolean @default(false)

  // Relasi ke dokumen/data yang dibutuhkan
  requirement_dokumen requirement_dokumen[]

  pendaftaran pendaftaran[]

  @@index([kode])
}

// ============================================================
// MASTER DOKUMEN/DATA YANG MUNGKIN DIBUTUHKAN
// ============================================================

enum TipeInputDokumen {
  FILE_UPLOAD   // Upload file (PDF, docx, dll)
  TEXT          // Input teks bebas
  URL           // Link/URL
  BOOLEAN       // Checkbox (sudah/belum)
  DATE          // Tanggal
  SELECT        // Pilihan dari opsi tertentu
  MULTI_SELECT  // Pilihan multiple (seperti mata kuliah pilihan)
}

model dokumen_template {
  id          String            @id @default(cuid())
  nama        String            @db.VarChar(150)   // "Surat Keterangan Instansi"
  kode        String            @unique @db.VarChar(50) // "SURAT_KET_INSTANSI"
  deskripsi   String?           @db.Text
  tipe_input  TipeInputDokumen
  
  // Untuk SELECT / MULTI_SELECT: simpan opsi yang tersedia
  opsi        Json?             // ["Kriptografi", "Jaringan Komputer", ...]
  
  // Validasi tambahan
  format_file  String?          @db.VarChar(50)    // "pdf,docx" jika FILE_UPLOAD
  max_size_mb  Int?                                 // Batas ukuran file
  
  // Apakah ini field khusus yang punya handling tersendiri di backend
  is_special   Boolean          @default(false)     // misal: field NIP dosen, dll

  requirement_dokumen requirement_dokumen[]

  data_pendaftaran data_pendaftaran[]
}

// ============================================================
// PIVOT: Dokumen apa saja yang dibutuhkan per Jenis Seminar
// ============================================================

model requirement_dokumen {
  id                  String   @id @default(cuid())
  id_jenis_seminar    String
  id_dokumen_template String
  
  urutan              Int      @default(0)   // Urutan tampil di form
  is_wajib            Boolean  @default(true)
  keterangan_tambahan String?  @db.Text      // Instruksi khusus untuk dokumen ini

  jenis_seminar    jenis_seminar    @relation(fields: [id_jenis_seminar], references: [id], onDelete: Cascade)
  dokumen_template dokumen_template @relation(fields: [id_dokumen_template], references: [id], onDelete: Cascade)

  @@unique([id_jenis_seminar, id_dokumen_template])
  @@index([id_jenis_seminar])
}

model pendaftaran {
  id                String       @id @default(cuid())
  nim               String       @db.VarChar(11)
  tahun_ajaran      String       @db.VarChar(5)
  id_pengajuan_fst  String       @unique @db.VarChar(50)

  id_jenis_seminar  String
  jenis_seminar     jenis_seminar @relation(fields: [id_jenis_seminar], references: [id])

  nim_mahasiswa     mahasiswa     @relation(fields: [nim], references: [nim])

  // Penilai — tetap eksplisit karena sering di-query LLM
  nip_pembimbing_1  String       @db.VarChar(18)
  nip_pembimbing_2  String?      @db.VarChar(18)
  nip_penguji_1     String?      @db.VarChar(18)
  nip_penguji_2     String?      @db.VarChar(18)
  nip_ketua_sidang  String?      @db.VarChar(18)

  status_berkas     StatusBerkas @default(PENDING)
  status_proses     Boolean      @default(false)
  created_at        DateTime     @default(now()) @db.Timestamptz

  // Relasi ke jawaban/isian dokumen
  data_pendaftaran  data_pendaftaran[]

  @@index([nim])
  @@index([id_jenis_seminar])
}

model data_pendaftaran {
  id                  String  @id @default(cuid())
  id_pendaftaran      String
  id_dokumen_template String

  // Nilai disimpan sesuai tipe — hanya satu yang terisi
  nilai_text     String?  @db.Text      // TEXT, URL
  nilai_file_url String?  @db.Text      // FILE_UPLOAD (URL hasil upload)
  nilai_boolean  Boolean?               // BOOLEAN
  nilai_date     DateTime? @db.Timestamptz // DATE
  nilai_json     Json?                  // SELECT, MULTI_SELECT, atau data kompleks

  pendaftaran      pendaftaran      @relation(fields: [id_pendaftaran], references: [id], onDelete: Cascade)
  dokumen_template dokumen_template @relation(fields: [id_dokumen_template], references: [id])

  @@unique([id_pendaftaran, id_dokumen_template]) // 1 dokumen = 1 jawaban per pendaftaran
  @@index([id_pendaftaran])
}