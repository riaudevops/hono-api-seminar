APP_VERSION='v1.0.3-alpha'
APP_PORT=5000

# =============================================================================
# For QR-CODE Validator ID Key
# =============================================================================
HANZ_CRYPTO_KEY="jiovej89envioev893ho3v983ncui439f439fhfwe"

# =============================================================================
# mail sender secret env key
# =============================================================================
EMAIL_USER=
EMAIL_PASS=
# Saat APP_ENV bukan production, semua email akan dialihkan ke alamat ini.
DEV_EMAIL_SINK=dev-sink@example.com

# =============================================================================
# Google Drive Upload Configuration
# =============================================================================
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_CALENDAR_ID=primary
# Opsional: isi dengan akun organizer Workspace jika memakai domain-wide delegation.
GOOGLE_CALENDAR_IMPERSONATE_EMAIL=

# =============================================================================
# Application Configuration
# =============================================================================
APP_NAME=HONO API SEMINAR
APP_VERSION=1.0.0
APP_ENV=development  # development, staging, production, testing
DEBUG=false

# =============================================================================
# Server Configuration
# =============================================================================
HOST=0.0.0.0
PORT=8000
WORKERS=1
# server/api menjalankan HTTP API, worker memproses queue Redis.
APP_PROCESS=server

# =============================================================================
# Database Configuration
# =============================================================================
DATABASE_URL="postgresql://postgres:123321@localhost:5432/db_test?schema=public"
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# =============================================================================
# CORS Configuration
# =============================================================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
# LOG_FILE=logs/app.log  # Uncomment to enable file logging

# =============================================================================
# API Configuration
# =============================================================================
API_PREFIX=/api/v1

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_ENABLED=true
REDIS_HOST="100.71.124.32"
REDIS_PORT="6379"
REDIS_PASSWORD=
# Optional, if set it overrides REDIS_HOST/REDIS_PORT
# REDIS_URL=redis://:password@100.71.124.32:6379
REDIS_KEY_PREFIX=seminar-tif
REDIS_DEFAULT_TTL_SECONDS=300
# Berapa lama status/result job worker disimpan di Redis.
WORKER_JOB_TTL_SECONDS=86400

# =============================================================================
# OpenRouter Configuration
# =============================================================================
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional comma-separated fallback models for OpenRouter route=fallback
OPENROUTER_MODELS=
OPENROUTER_TIMEOUT_MS=90000
OPENROUTER_MAX_RETRIES=2
OPENROUTER_USE_LOW_LATENCY_ROUTING=true